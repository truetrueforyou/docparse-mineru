DOCPARSE_DATABASE_URL=sqlite:///./data/docparse.db
DOCPARSE_STORAGE_BACKEND=local
DOCPARSE_LOCAL_STORAGE_DIR=./data/objects

# Use these for MinIO deployment.
# DOCPARSE_STORAGE_BACKEND=minio
# DOCPARSE_MINIO_ENDPOINT_URL=http://minio.example.internal:9000
# DOCPARSE_MINIO_ACCESS_KEY=replace-me
# DOCPARSE_MINIO_SECRET_KEY=replace-me
# DOCPARSE_MINIO_BUCKET=docparse-mineru34
# DOCPARSE_MINIO_SECURE=false

DOCPARSE_MAX_FILE_SIZE_MB=200
DOCPARSE_RUN_TASKS_INLINE=false
DOCPARSE_MINERU_COMMAND=mineru
DOCPARSE_MINERU_DEVICE=auto
DOCPARSE_MINERU_CPU_EXTRA_ARGS=-b pipeline -d cpu --source local
DOCPARSE_MINERU_NPU_EXTRA_ARGS=-b pipeline -d npu --source local
DOCPARSE_MINERU_EXTRA_ARGS=
DOCPARSE_DISABLE_NPU_PROBE=false
